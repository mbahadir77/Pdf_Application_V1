<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_mesh_gradient"
    android:orientation="vertical"
    android:paddingBottom="16dp">

    <!-- Tutamaç Çubuğu (Drag Handle) -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_pdf_chip" />

    <!-- Başlık ve Kapatma -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingTop="14dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Akademik Müzakere &amp; Tahliller"
            android:textColor="@color/text_primary"
            android:textSize="17sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btn_close_comments"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@null"
            android:padding="4dp"
            android:src="@drawable/ic_close_circle"
            app:tint="@color/text_tertiary" />
    </LinearLayout>

    <!-- Post Başlığı Özeti -->
    <TextView
        android:id="@+id/tv_comment_post_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingHorizontal="20dp"
        android:textColor="@color/gold_start"
        android:textSize="12sp"
        tools:text="Konu: Klasik Tefsirde Semantik Tahlil" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0.8dp"
        android:layout_marginTop="10dp"
        android:background="@color/glass_stroke_white" />

    <!-- Yorumlar Listesi veya Boş Durum -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="280dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_comments"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingVertical="8dp"
            tools:listitem="@layout/item_comment" />

        <!-- Shimmer İskelet Yükleme (FAZ 8) -->
        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/shimmer_comments"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            app:shimmer_auto_start="true"
            app:shimmer_base_alpha="0.25"
            app:shimmer_base_color="#183327"
            app:shimmer_colored="true"
            app:shimmer_duration="1200"
            app:shimmer_highlight_alpha="0.75"
            app:shimmer_highlight_color="#40D4AF37">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <include layout="@layout/item_skeleton_comment" />
                <include layout="@layout/item_skeleton_comment" />
                <include layout="@layout/item_skeleton_comment" />
            </LinearLayout>
        </com.facebook.shimmer.ShimmerFrameLayout>

        <LinearLayout
            android:id="@+id/layout_comments_empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💬"
                android:textSize="32sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Henüz akademik tahlil yazılmadı"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="İlk müzakere notunu düşerek ilmi tartışmayı başlatın!"
                android:textColor="@color/text_tertiary"
                android:textSize="11sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- Yorum Yazma Giriş Alanı -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_glass_input_selector"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp">

        <EditText
            android:id="@+id/et_comment_input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@null"
            android:hint="Yorum veya müzakere notu yazın..."
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="3"
            android:minHeight="40dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_tertiary"
            android:textSize="13sp" />

        <ImageView
            android:id="@+id/btn_send_comment"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_btn_academic_gold"
            android:contentDescription="@null"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_forward"
            app:tint="@color/btn_text_dark" />
    </LinearLayout>

</LinearLayout>
