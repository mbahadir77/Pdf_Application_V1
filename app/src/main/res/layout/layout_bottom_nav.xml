<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/container_floating_nav"
    android:layout_width="wrap_content"
    android:layout_height="64dp"
    android:layout_gravity="bottom|center_horizontal"
    android:layout_marginBottom="24dp"
    android:background="@drawable/bg_glass_tab_bar"
    android:elevation="12dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp">

    <!-- Sekme 1: Ana Ekran (Feed) -->
    <LinearLayout
        android:id="@+id/tab_nav_feed"
        android:layout_width="84dp"
        android:layout_height="match_parent"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/iv_tab_feed"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_nav_feed" />

        <TextView
            android:id="@+id/tv_tab_feed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Akış"
            android:textColor="@color/gold_start"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Sekme 2: PDF Ekle (Ortada Özel Altın Buton) -->
    <FrameLayout
        android:id="@+id/tab_nav_add_pdf"
        android:layout_width="56dp"
        android:layout_height="match_parent"
        android:layout_marginHorizontal="6dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true">

        <View
            android:id="@+id/view_bg_add_pdf"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_btn_gold_pill" />

        <ImageView
            android:id="@+id/iv_tab_add_pdf"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="center"
            android:contentDescription="PDF Ekle"
            android:src="@drawable/ic_nav_add_pdf" />
    </FrameLayout>

    <!-- Sekme 3: Profil -->
    <LinearLayout
        android:id="@+id/tab_nav_profile"
        android:layout_width="84dp"
        android:layout_height="match_parent"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/iv_tab_profile"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_nav_profile" />

        <TextView
            android:id="@+id/tv_tab_profile"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Profil"
            android:textColor="@color/text_tertiary"
            android:textSize="11sp" />
    </LinearLayout>

</LinearLayout>
