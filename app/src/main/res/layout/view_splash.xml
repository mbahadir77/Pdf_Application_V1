<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/splash_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_mesh_gradient">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="32dp">

        <!-- Logo Container with glowing glass ring -->
        <FrameLayout
            android:layout_width="128dp"
            android:layout_height="128dp">

            <View
                android:layout_width="128dp"
                android:layout_height="128dp"
                android:background="@drawable/bg_glass_badge" />

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/iv_splash_logo"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_gravity="center"
                android:contentDescription="@string/app_name"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_academic_logo"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full" />
        </FrameLayout>

        <!-- Academic Title -->
        <TextView
            android:id="@+id/tv_splash_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:letterSpacing="0.06"
            android:text="@string/app_name"
            android:textColor="@color/gold_start"
            android:textSize="38sp"
            android:textStyle="bold" />

        <!-- Subtitle -->
        <TextView
            android:id="@+id/tv_splash_tagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:letterSpacing="0.04"
            android:text="@string/tag_line"
            android:textColor="@color/text_secondary"
            android:textSize="15sp" />

        <!-- Loading Spinner -->
        <ProgressBar
            android:id="@+id/pb_splash_loading"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginTop="48dp"
            android:indeterminate="true"
            android:indeterminateTint="@color/gold_center" />
    </LinearLayout>

    <!-- Bottom Academic Motto -->
    <TextView
        android:id="@+id/tv_splash_motto"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="32dp"
        android:paddingHorizontal="24dp"
        android:text="@string/splash_motto"
        android:textAlignment="center"
        android:textColor="@color/text_tertiary"
        android:textSize="12sp" />
</FrameLayout>
