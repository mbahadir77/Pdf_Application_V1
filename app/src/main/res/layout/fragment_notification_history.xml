<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D1117"
    android:orientation="vertical">

    <!-- Üst Başlık Çubuğu -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp">

        <ImageView
            android:id="@+id/btn_notification_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="Geri Dön"
            android:focusable="true"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/gold_start" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="serif"
                android:text="İlmi Bildirim Merkezi"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_notification_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Müzakere, rozet ve hikmet kayıtları"
                android:textColor="@color/text_tertiary"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Tümünü Okundu İşaretle -->
        <ImageView
            android:id="@+id/btn_mark_all_read"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginEnd="6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="Tümünü Okundu İşaretle"
            android:focusable="true"
            android:padding="8dp"
            android:src="@drawable/ic_check_circle"
            app:tint="@color/gold_vibrant" />

        <!-- Tümünü Temizle -->
        <ImageView
            android:id="@+id/btn_clear_all_notifications"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="Tüm Bildirimleri Temizle"
            android:focusable="true"
            android:padding="8dp"
            android:src="@drawable/ic_trash"
            app:tint="@color/text_tertiary" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1FFFFFFF" />

    <!-- Ana İçerik Çerçevesi -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Shimmer İskelet Yükleme Ekranı -->
        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/shimmer_notifications"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            app:shimmer_auto_start="true"
            app:shimmer_base_alpha="0.2"
            app:shimmer_duration="1000"
            app:shimmer_highlight_alpha="0.6">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="12dp">

                <include layout="@layout/item_skeleton_notification" />
                <include layout="@layout/item_skeleton_notification" />
                <include layout="@layout/item_skeleton_notification" />
                <include layout="@layout/item_skeleton_notification" />
            </LinearLayout>
        </com.facebook.shimmer.ShimmerFrameLayout>

        <!-- Boş Durum (Empty State) -->
        <LinearLayout
            android:id="@+id/layout_empty_notifications"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:alpha="0.6"
                android:src="@drawable/ic_notification_bell"
                app:tint="@color/gold_start" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="serif"
                android:text="Henüz Bir Bildirim Yok"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:text="Risalelerinize yapılan yorumlar, yeni rozetleriniz ve alim meclisinden haberler burada listelenecektir."
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Bildirim Listesi (Kaydırarak Silme Desteğiyle) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_notifications"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="8dp"
            android:paddingBottom="24dp"
            tools:listitem="@layout/item_notification" />
    </FrameLayout>

</LinearLayout>
