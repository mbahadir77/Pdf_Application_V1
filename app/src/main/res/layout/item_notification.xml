<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_notification"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="#1A1E26"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="#26FFD700"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <!-- Tür İkonu Kutusu -->
        <FrameLayout
            android:id="@+id/container_notification_icon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_glass_badge">

            <TextView
                android:id="@+id/tv_notification_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="📜"
                android:textSize="20sp" />
        </FrameLayout>

        <!-- İçerik Alanı -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_notification_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="serif"
                    android:maxLines="1"
                    android:textColor="#FFD700"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="Akademik Yorum Geldi! 🖋️" />

                <!-- Okunmamış Durum Noktası -->
                <View
                    android:id="@+id/view_unread_dot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_color_dot_yellow" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_notification_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingExtra="2dp"
                android:textColor="#E0E6ED"
                android:textSize="12sp"
                tools:text="Doç. Dr. Fârâbî eserin hakkında fikrini beyan etti. Alimler müzakereyi sever!" />

            <TextView
                android:id="@+id/tv_notification_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="#8A99AD"
                android:textSize="10sp"
                tools:text="Bugün, 14:32" />
        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
