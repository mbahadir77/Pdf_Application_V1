<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_badge_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="5dp"
    android:background="@drawable/bg_glass_card"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Üst Satır: Kategori İkonu, Adı ve Seviye Rozeti (LVL X) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/iv_badge_vector_icon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginEnd="6dp"
            android:contentDescription="Rozet Vektör İkonu"
            android:src="@drawable/ic_badge_book"
            app:tint="@color/gold_vibrant" />

        <TextView
            android:id="@+id/tv_badge_tier_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:textSize="18sp"
            tools:text="📜" />

        <TextView
            android:id="@+id/tv_badge_category"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/gold_vibrant"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="Hadis" />

        <!-- 20 Seviye Göstergesi Rozeti (LVL 1 - 20) -->
        <TextView
            android:id="@+id/tv_badge_level_tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_glass_badge"
            android:paddingHorizontal="7dp"
            android:paddingVertical="2dp"
            android:textColor="@color/gold_vibrant"
            android:textSize="10sp"
            android:textStyle="bold"
            tools:text="LVL 13" />
    </LinearLayout>

    <!-- Rütbe Unvanı (Örn: Muhaddis, Fakih, Allâme) -->
    <TextView
        android:id="@+id/tv_badge_tier_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/text_primary"
        android:textSize="12sp"
        android:textStyle="bold"
        tools:text="Muhaddis" />

    <!-- Dinamik Rütbe Açıklaması -->
    <TextView
        android:id="@+id/tv_badge_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/text_tertiary"
        android:textSize="10sp"
        tools:text="Muhaddis: 13 Hadis eseri mütalaa ettin/paylaştın." />

    <!-- 4 Kademeli Yıldızlar (Gizli veya Seviye Temsilcisi) -->
    <LinearLayout
        android:id="@+id/layout_badge_stars"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_badge_star1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⭐"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/tv_badge_star2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:text="⭐"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/tv_badge_star3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:text="⭐"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/tv_badge_star4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:text="⭐"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- İlerleme Çubuğu -->
    <ProgressBar
        android:id="@+id/pb_badge_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="5dp"
        android:layout_marginTop="6dp"
        android:max="100"
        android:progress="65"
        android:progressTint="@color/gold_vibrant" />

    <!-- Alt Bilgi: Eser Sayacı ve Sıradaki Rütbe -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_badge_progress_counter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/gold_start"
            android:textSize="10sp"
            android:textStyle="bold"
            tools:text="13/16 Eser" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tv_badge_next_tier_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_tertiary"
            android:textSize="9sp"
            tools:text="Hedef: Müdekkik-i Sünnet" />
    </LinearLayout>

</LinearLayout>
