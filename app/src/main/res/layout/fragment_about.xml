<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/about_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_mesh_gradient">

    <!-- Ana Jenerik İçerik Scroll -->
    <ScrollView
        android:id="@+id/scroll_credits"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="36dp"
            android:paddingBottom="60dp">

            <!-- Kapatma Butonu Üst Çubuğu -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:letterSpacing="0.2"
                    android:text="CREDITS &amp; KÜNYE"
                    android:textColor="#D4AF37"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/btn_close_credits"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="end|center_vertical"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:contentDescription="Kapat"
                    android:focusable="true"
                    android:padding="6dp"
                    android:src="@drawable/ic_close_circle"
                    app:tint="#888888" />
            </FrameLayout>

            <!-- İlmNet Logo (Easter Egg 10 Tık Hedefi) -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_logo_container"
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:layout_marginTop="28dp"
                app:cardBackgroundColor="#111111"
                app:cardCornerRadius="44dp"
                app:cardElevation="12dp">

                <ImageView
                    android:id="@+id/iv_credits_logo"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clickable="true"
                    android:contentDescription="İlmNet Amblemi"
                    android:focusable="true"
                    android:padding="6dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_academic_logo" />
            </androidx.cardview.widget.CardView>

            <!-- Oyun Jeneriği Başlığı -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:fontFamily="serif"
                android:letterSpacing="0.25"
                android:text="İ L M N E T"
                android:textColor="#FFD700"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:letterSpacing="0.1"
                android:text="AKADEMİK TEVHİD VE İLİM PLATFORMU"
                android:textColor="#A0A0A0"
                android:textSize="11sp" />

            <View
                android:layout_width="120dp"
                android:layout_height="1dp"
                android:layout_marginTop="24dp"
                android:background="#44FFD700" />

            <!-- ================= JENERİK KADRO LİSTESİ ================= -->

            <!-- Rol 1 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:letterSpacing="0.15"
                android:text="BAŞ MİMARI VE PROJE YÖNETİCİSİ"
                android:textColor="#D4AF37"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="serif"
                android:letterSpacing="0.05"
                android:text="Muhammed Bahadır Yıldırım"
                android:textColor="#FFFFFF"
                android:textSize="19sp"
                android:textStyle="bold" />

            <!-- Rol 2 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:letterSpacing="0.15"
                android:text="YAZILIM GELİŞTİRME (ANDROID / KOTLIN)"
                android:textColor="#D4AF37"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="serif"
                android:letterSpacing="0.05"
                android:text="Muhammed Bahadır Yıldırım"
                android:textColor="#FFFFFF"
                android:textSize="19sp"
                android:textStyle="bold" />

            <!-- Rol 3 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:letterSpacing="0.15"
                android:text="ARAYÜZ TASARIMI (UI/UX GLASSMORPHISM)"
                android:textColor="#D4AF37"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="serif"
                android:letterSpacing="0.05"
                android:text="Muhammed Bahadır Yıldırım"
                android:textColor="#FFFFFF"
                android:textSize="19sp"
                android:textStyle="bold" />

            <!-- Rol 4 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:letterSpacing="0.15"
                android:text="VERİTABANI VE BULUT MİMARİSİ"
                android:textColor="#D4AF37"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="serif"
                android:letterSpacing="0.05"
                android:text="Muhammed Bahadır Yıldırım"
                android:textColor="#FFFFFF"
                android:textSize="19sp"
                android:textStyle="bold" />

            <!-- Rol 5: Şirket -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:letterSpacing="0.15"
                android:text="ŞİRKET &amp; TEKNOLOJİ"
                android:textColor="#D4AF37"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="serif"
                android:letterSpacing="0.08"
                android:text="Yıldırım Technologies"
                android:textColor="#FFD700"
                android:textSize="20sp"
                android:textStyle="bold" />

            <View
                android:layout_width="120dp"
                android:layout_height="1dp"
                android:layout_marginTop="36dp"
                android:background="#44FFD700" />

            <!-- Sürüm & Misyon Notu -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:text="&quot;Sadaka-i cariye niyetiyle, ilmi mirası dijital çağda muhafaza etmek ve araştırmacılara ulaştırmak üzere geliştirilmiştir.&quot;"
                android:textColor="#888888"
                android:textSize="12sp"
                android:textStyle="italic" />

            <!-- GitHub Butonu -->
            <LinearLayout
                android:id="@+id/btn_credits_github"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginTop="32dp"
                android:background="@drawable/bg_glass_card"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingHorizontal="24dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="GitHub"
                    android:src="@drawable/ic_github_outline"
                    app:tint="#FFD700" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:letterSpacing="0.05"
                    android:text="github.com/mbahadir77"
                    android:textColor="#FFD700"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Sürüm Günlükleri (Release Notes) Butonu -->
            <Button
                android:id="@+id/btn_release_notes"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginTop="20dp"
                android:backgroundTint="#1F1608"
                android:drawableStart="@drawable/ic_badge_book"
                android:drawablePadding="8dp"
                android:drawableTint="#FFD700"
                android:fontFamily="serif"
                android:letterSpacing="0.05"
                android:paddingHorizontal="20dp"
                android:text="📜 Sürüm Günlükleri (Tarihçe)"
                android:textColor="#FFD700"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="v1.0.0 • Faz 12 Master Max Pro Ultimate"
                android:textColor="#555555"
                android:textSize="11sp" />

        </LinearLayout>
    </ScrollView>

    <!-- ================= SİNEMATİK GİZEM (10 TIKLAMA EASTER EGG OVERLAY) ================= -->
    <FrameLayout
        android:id="@+id/layout_mystery_cinematic"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:clickable="true"
        android:elevation="30dp"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/layout_cinematic_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="32dp">

            <ImageView
                android:id="@+id/iv_cinematic_glow_logo"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:contentDescription="Altın Mühür"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_academic_logo"
                app:tint="#FFD700" />

            <TextView
                android:id="@+id/tv_cinematic_mystery_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:fontFamily="serif"
                android:gravity="center"
                android:letterSpacing="0.08"
                android:lineSpacingExtra="10dp"
                android:text="Gerçeği arayan yolcu...\nİlim Diyârı'nın kalbine ulaştın."
                android:textColor="#FFD700"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_cinematic_subtext"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:letterSpacing="0.15"
                android:text="• YILDIRIM TECHNOLOGIES •"
                android:textColor="#C5A059"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:letterSpacing="0.05"
                android:text="[Kapatmak için ekrana dokunun]"
                android:textColor="#666666"
                android:textSize="12sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- ================= IMF EASTER EGG OVERLAY ================= -->
    <FrameLayout
        android:id="@+id/layout_easter_egg_terminal"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Terminal Başlık Çubuğu -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:background="@drawable/bg_color_dot_red" />

                <View
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_color_dot_yellow" />

                <View
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_color_dot_green" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:fontFamily="monospace"
                    android:text="SECURE_SHELL // PROTOCOL-77"
                    android:textColor="#00FF66"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btn_terminal_exit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="monospace"
                    android:padding="8dp"
                    android:text="[KAPAT]"
                    android:textColor="#FF4444"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="12dp"
                android:background="#2200FF66" />

            <!-- Monospace Terminal Ekranı -->
            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="16dp"
                android:layout_weight="1"
                android:scrollbars="none">

                <TextView
                    android:id="@+id/tv_terminal_output"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:lineSpacingExtra="6dp"
                    android:textColor="#00FF66"
                    android:textSize="13sp"
                    tools:text="Gizli protokole erişildi..." />
            </ScrollView>

            <!-- IMF Tarzı Kendini İmha Eden Kırmızı Sayaç -->
            <TextView
                android:id="@+id/tv_terminal_countdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="monospace"
                android:gravity="center"
                android:padding="8dp"
                android:textColor="#FF3333"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="⚠️ Bu mesaj 10 saniye içinde kendini imha edecektir: 10"
                tools:visibility="visible" />

            <Button
                android:id="@+id/btn_terminal_confirm"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:backgroundTint="#003311"
                android:fontFamily="monospace"
                android:letterSpacing="0.1"
                android:text="GÖREV KABUL EDİLDİ // DEVAM ET"
                android:textColor="#00FF66"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>

</FrameLayout>
