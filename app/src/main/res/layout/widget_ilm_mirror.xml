<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_glass"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="16dp">

    <!-- Sol Taraf: Durum Görseli (ic_widget_active, ic_widget_warning, ic_widget_abandoned) -->
    <ImageView
        android:id="@+id/iv_widget_status_icon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:contentDescription="İlim Aynası Durumu"
        android:src="@drawable/ic_widget_active" />

    <!-- Sağ Taraf: Başlık, Streak & Durum Metni -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_widget_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="serif"
                android:maxLines="1"
                android:text="İlmNet • İlim Aynası"
                android:textColor="#FFD700"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_widget_streak_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_glass_badge"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:text="🔥 1 Gün"
                android:textColor="#FFB300"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Durum Bazlı Rastgele Hikmetli Söz -->
        <TextView
            android:id="@+id/tv_widget_quote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:lineSpacingExtra="2dp"
            android:maxLines="3"
            android:text="İlmin nuru parlıyor. Bugün de satırların hakkını verdin!"
            android:textColor="#E0E6ED"
            android:textSize="11sp" />
    </LinearLayout>

</LinearLayout>
