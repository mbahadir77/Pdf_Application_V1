<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 1. Tam Boyutlu Arka Plan Görseli (centerCrop) -->
    <ImageView
        android:id="@+id/iv_widget_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="İlim Aynası Arka Planı"
        android:scaleType="centerCrop"
        android:src="@drawable/widget_ilm_bg" />

    <!-- 2. %60 Siyah Karartma Katmanı (#99000000) -->
    <View
        android:id="@+id/view_widget_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000" />

    <!-- İnce Altın Kenarlık Çerçevesi -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_widget_glass" />

    <!-- 3. Beyaz ve Altın Tipografi ile İçerik Katmanı -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Üst Başlık ve Streak Rozeti -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/iv_widget_status_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginEnd="8dp"
                android:contentDescription="Durum İkonu"
                android:src="@drawable/ic_widget_active" />

            <TextView
                android:id="@+id/tv_widget_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="serif"
                android:maxLines="1"
                android:text="İlim Diyârı • İlim Aynası"
                android:textColor="#FFD700"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_widget_streak_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_glass_badge"
                android:paddingHorizontal="7dp"
                android:paddingVertical="3dp"
                android:text="🔥 1 Gün İstikrar"
                android:textColor="#FFE082"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Hikmetli İlmi Söz (Beyaz Tipografi) -->
        <TextView
            android:id="@+id/tv_widget_quote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:lineSpacingExtra="3dp"
            android:maxLines="3"
            android:text="İlmin nuru parlıyor. Bugün de satırların hakkını verdin!"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="normal" />

        <!-- Alt Durum Metni -->
        <TextView
            android:id="@+id/tv_widget_status_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="📜 Günlük mütalaa ve tahlil halkası"
            android:textColor="#CFD8DC"
            android:textSize="10sp" />
    </LinearLayout>

</RelativeLayout>
