<?xml version="1.0" encoding="utf-8"?>
<!--
    İlim Diyârı - Buzlu Cam Shimmer Skeleton Yükleme Ekranı (FAZ 13).
    GitHub'dan PDF'ler çekilirken ekranda yanıp sönen cam iskeletler gösterilir.
-->
<com.facebook.shimmer.ShimmerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_post_shimmer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:shimmer_auto_start="true"
    app:shimmer_base_alpha="0.25"
    app:shimmer_base_color="#183327"
    app:shimmer_colored="true"
    app:shimmer_duration="1200"
    app:shimmer_highlight_alpha="0.75"
    app:shimmer_highlight_color="#40D4AF37">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="8dp"
        android:paddingBottom="96dp">

        <include layout="@layout/item_skeleton_post" />
        <include layout="@layout/item_skeleton_post" />
        <include layout="@layout/item_skeleton_post" />
        <include layout="@layout/item_skeleton_post" />

    </LinearLayout>

</com.facebook.shimmer.ShimmerFrameLayout>
