<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_mesh_gradient"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="48dp"
        android:paddingBottom="90dp">

        <!-- Üst Bar: Geri Butonu & Başlık -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btn_edit_profile_back"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_tab_container"
                android:contentDescription="Geri"
                android:padding="10dp"
                android:src="@drawable/ic_arrow_back" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Profili Düzenle"
                    android:textColor="@color/text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" Kimlik &amp; Özgeçmiş"
                    android:textColor="@color/gold_start"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Profil Fotoğrafı Seçim Alanı -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/container_edit_avatar"
                android:layout_width="100dp"
                android:layout_height="100dp">

                <!-- Yuvarlak Fotoğraf Önizleme -->
                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/iv_edit_avatar_preview"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:background="@drawable/bg_circle_avatar"
                    android:contentDescription="Profil Fotoğrafı Önizleme"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_person_outline"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.App.Circle"
                    app:strokeColor="@color/gold_vibrant"
                    app:strokeWidth="2dp" />

                <!-- Galeri Kamera İkon Rozeti -->
                <FrameLayout
                    android:id="@+id/btn_edit_pick_avatar"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_gravity="bottom|end"
                    android:background="@drawable/bg_btn_gold_vibrant_pill"
                    android:clickable="true"
                    android:elevation="4dp"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:contentDescription="Galeriden Fotoğraf Seç"
                        android:src="@drawable/ic_camera"
                        app:tint="@color/btn_text_dark" />
                </FrameLayout>
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Fotoğrafı Değiştirmek İçin Dokunun (Galeri)"
                android:textColor="@color/gold_start"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Form Kartı (Cam Efekti) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_glass_card"
            android:orientation="vertical"
            android:padding="18dp">

            <!-- 1. Ad Soyad -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ad ve Soyad *"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/et_edit_name"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_glass_input_selector"
                android:hint="Örn: Dr. Ahmet Farabi"
                android:imeOptions="actionNext"
                android:inputType="textPersonName"
                android:paddingHorizontal="14dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_tertiary"
                android:textSize="14sp" />

            <!-- 2. Akademik Unvan & Bölüm -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text=" Unvan &amp; Bölüm"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/et_edit_title"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_glass_input_selector"
                android:hint="Örn: Doç. Dr. • İlahiyat Fakültesi Tefsir "
                android:imeOptions="actionNext"
                android:inputType="text"
                android:paddingHorizontal="14dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_tertiary"
                android:textSize="14sp" />

            <!-- 3. Biyografi / Özgeçmiş -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text=" Özgeçmiş &amp; İlgi Alanları"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/et_edit_bio"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_glass_input_selector"
                android:gravity="top|start"
                android:hint="Çalışma alanlarınız,  araştırmalarınız ve yayınlarınız hakkında kısa bir özet..."
                android:inputType="textMultiLine"
                android:lineSpacingExtra="3dp"
                android:padding="14dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_tertiary"
                android:textSize="13sp" />

            <!-- Hata Metni -->
            <TextView
                android:id="@+id/tv_edit_profile_error"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="@color/error_red"
                android:textSize="12sp"
                android:visibility="gone"
                tools:text="Lütfen ad soyad alanını doldurunuz." />

            <!-- Kaydet Butonu -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_edit_profile_save"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/btn_academic_gold_selector"
                android:elevation="4dp"
                android:text="Değişiklikleri Kaydet"
                android:textAllCaps="false"
                android:textColor="@color/btn_text_dark"
                android:textSize="15sp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/pb_edit_profile_loading"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:indeterminateTint="@color/gold_vibrant"
                android:visibility="gone" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
