<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/dashboard_scroll_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_mesh_gradient"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="20dp"
        android:paddingBottom="90dp">

        <!-- Üst Başlık ve Çıkış Barı -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.imageview.ShapeableImageView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:contentDescription="@string/app_name"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_academic_logo"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" Profil"
                    android:textColor="@color/gold_start"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="İlim Diyârı Araştırmacı Portali"
                    android:textColor="@color/text_tertiary"
                    android:textSize="11sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/btn_dashboard_settings"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_tab_container"
                android:contentDescription="Ayarlar"
                android:padding="8dp"
                android:src="@drawable/ic_settings" />
        </LinearLayout>

        <!-- Akademik Profil Kartı (Cam Efekti) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_glass_card"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="60dp"
                    android:layout_height="60dp">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/iv_dash_avatar"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:background="@drawable/bg_circle_avatar"
                        android:contentDescription="Profil Fotoğrafı"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_person_outline"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.App.Circle"
                        app:strokeColor="@color/gold_vibrant"
                        app:strokeWidth="1.5dp" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_dash_user_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_primary"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        tools:text="Doç. Dr. Ahmet Farabi" />

                    <TextView
                        android:id="@+id/tv_dash_user_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:text="İlahiyat Fakültesi • Tefsir ABD"
                        android:textColor="@color/gold_start"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tv_dash_user_email"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp"
                        tools:text="ahmet.farabi@ilmnet.org" />
                </LinearLayout>
            </LinearLayout>

            <!-- Akademik Özgeçmiş / Biyografi -->
            <TextView
                android:id="@+id/tv_dash_user_bio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="#14FFFFFF"
                android:lineSpacingExtra="2dp"
                android:paddingHorizontal="10dp"
                android:paddingVertical="6dp"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:visibility="gone"
                tools:text="Tefsir tarihi, klasik metinler ve modern Kur'an araştırmaları üzerine çalışmalar yapmaktadır." />

            <!-- Cam Efektli İnce 'Profili Düzenle' Butonu -->
            <LinearLayout
                android:id="@+id/btn_edit_profile"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_btn_glass_outline"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_edit" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Profili Düzenle"
                    android:textColor="@color/gold_vibrant"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- İstatistik Özet Şeridi -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="#1CFFFFFF"
                android:baselineAligned="false"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingVertical="10dp">

                <!-- Eser Sayısı -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_dash_stats_works_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/gold_vibrant"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        tools:text="4" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Eser"
                        android:textColor="@color/text_tertiary"
                        android:textSize="11sp" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="24dp"
                    android:background="#33FFFFFF" />

                <!-- Kazanılan Rozet Sayısı -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_dash_stats_badges_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/gold_vibrant"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        tools:text="4/20" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Rozet"
                        android:textColor="@color/text_tertiary"
                        android:textSize="11sp" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="24dp"
                    android:background="#33FFFFFF" />

                <!-- Rütbe / Seviye -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_dash_stats_level"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/gold_vibrant"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        tools:text="Talip" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Genel Kademe"
                        android:textColor="@color/text_tertiary"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- İki Cam Efektli Sekme Butonları (Paylaşılan Eserler | Rozetler) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_tab_container"
            android:orientation="horizontal"
            android:padding="4dp">

            <!-- Sekme 1: Paylaşılan Eserler -->
            <FrameLayout
                android:id="@+id/btn_tab_shared_works"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_tab_active"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:id="@+id/tv_tab_shared_works_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="📚 Paylaşılan Eserler"
                    android:textColor="@color/gold_start"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <!-- Sekme 2: Rozetler -->
            <FrameLayout
                android:id="@+id/btn_tab_badges"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_tab_inactive"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:id="@+id/tv_tab_badges_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="🎖️ Rozetler (20)"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </FrameLayout>
        </LinearLayout>

        <!-- Sekme İçeriği 1: Paylaşılan Eserler Listesi (Ciltli Kitaplık) -->
        <LinearLayout
            android:id="@+id/layout_tab_shared_works"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:visibility="visible">

            <!-- Kütüphane Rafı Başlığı ve Görünüm Seçeneği -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_shelf_header_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:letterSpacing="0.04"
                    android:text="📖 Kütüphane Rafı (Ciltli Eserler)"
                    android:textColor="@color/gold_vibrant"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/btn_profile_layout_toggle"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Görünüm Değiştir"
                    android:padding="6dp"
                    android:src="@drawable/ic_view_list"
                    app:tint="@color/gold_vibrant" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_profile_shared_works"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_wooden_library_shelf"
                android:nestedScrollingEnabled="false"
                android:padding="8dp"
                tools:itemCount="4"
                tools:listitem="@layout/item_book_spine" />

            <TextView
                android:id="@+id/tv_profile_no_works"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:gravity="center"
                android:text="Henüz yayınlanmış bir akademik eseriniz bulunmuyor.\n'+ PDF Ekle' sekmesinden hemen ilk eserinizi yükleyebilirsiniz."
                android:textColor="@color/text_tertiary"
                android:textSize="13sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Sekme İçeriği 2: 20 Akademik Kategori Rozet Matrisi -->
        <LinearLayout
            android:id="@+id/layout_tab_badges"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Rozet Kademeleri İzah Çubuğu -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_glass_card"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Akademik Rütbe Kademeleri"
                    android:textColor="@color/gold_vibrant"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:lineSpacingExtra="2dp"
                    android:text="1 Eser: Talip ⭐ • 5 Eser: Muhaddis/Müfessir ⭐⭐ • 15 Eser: Hâfız/Müçtehid ⭐⭐⭐ • 50 Eser: Allâme ⭐⭐⭐⭐"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- 2 Sütunlu Rozet Grid Izgarası -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_academic_badges"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:nestedScrollingEnabled="false"
                tools:itemCount="4"
                tools:listitem="@layout/item_academic_badge" />
        </LinearLayout>

        <!-- Çıkış Butonu -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_dash_logout_action"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_glass_input"
            android:letterSpacing="0.04"
            android:stateListAnimator="@null"
            android:text="@string/btn_logout"
            android:textAllCaps="false"
            android:textColor="@color/error_red"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
