<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_splash_gradient">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbar_visitor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:elevation="0dp">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_scrollFlags="scroll|exitUntilCollapsed">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="36dp"
                android:paddingBottom="16dp">

                <!-- Üst Toolbar (Geri Butonu & Başlık) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp">

                    <ImageButton
                        android:id="@+id/btn_visitor_back"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Geri"
                        android:src="@drawable/ic_arrow_back"
                        app:tint="@color/text_primary" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="Ziyaretçi Profili"
                        android:textColor="@color/text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Profil Başlık Kartı (Avatar, İsim, Akademik Unvan) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_glass_card"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Avatar Çerçevesi -->
                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/iv_visitor_avatar"
                        android:layout_width="96dp"
                        android:layout_height="96dp"
                        android:contentDescription="Ziyaretçi Avatarı"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_academic_logo"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
                        app:strokeColor="@color/gold_vibrant"
                        app:strokeWidth="2.5dp" />

                    <TextView
                        android:id="@+id/tv_visitor_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:textColor="@color/text_primary"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        tools:text="Doç. Dr. Muhammed Rıza" />

                    <TextView
                        android:id="@+id/tv_visitor_academic_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:textColor="@color/gold_vibrant"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        tools:text="Hadis &amp; İsnad Tahlili Kürsüsü" />

                    <TextView
                        android:id="@+id/tv_visitor_bio"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:lineSpacingExtra="2dp"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        tools:text="Klasik hadis metinleri, rical usûlü ve cerh-tadil alanında akademik çalışmalar yürütmektedir." />

                    <!-- İstatistik Sayacı: Takipçi, Takip, Eser Sayısı -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tv_visitor_posts_count"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/gold_start"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                tools:text="8" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Eser"
                                android:textColor="@color/text_tertiary"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="24dp"
                            android:background="@color/glass_stroke_white" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tv_visitor_followers_count"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/gold_start"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                tools:text="142" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Takipçi"
                                android:textColor="@color/text_tertiary"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="24dp"
                            android:background="@color/glass_stroke_white" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tv_visitor_badges_count"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/gold_start"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                tools:text="5" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Rozet"
                                android:textColor="@color/text_tertiary"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Devasa Takip Et / Takip Ediliyor Butonu -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_visitor_follow"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="16dp"
                        android:backgroundTint="@color/gold_vibrant"
                        android:text="+ Takip Et"
                        android:textAllCaps="false"
                        android:textColor="@color/btn_text_dark"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:cornerRadius="24dp" />

                </LinearLayout>

                <!-- Sekme Seçici: Eserler / Rozetler -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_tab_container"
                    android:orientation="horizontal"
                    android:padding="3dp">

                    <TextView
                        android:id="@+id/tab_visitor_pdfs"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_tab_active"
                        android:gravity="center"
                        android:text="Paylaştığı Risaleler"
                        android:textColor="@color/gold_vibrant"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tab_visitor_badges"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_tab_inactive"
                        android:gravity="center"
                        android:text="Akademik Rozetler"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.appbar.CollapsingToolbarLayout>

    </com.google.android.material.appbar.AppBarLayout>

    <!-- İçerik Alanı: PDF Listesi & Rozet Listesi -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- PDF Listesi -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_visitor_pdfs"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="48dp"
            tools:listitem="@layout/item_post" />

        <!-- Rozet Listesi (Grid) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_visitor_badges"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="10dp"
            android:paddingBottom="48dp"
            android:visibility="gone"
            tools:listitem="@layout/item_academic_badge" />

        <!-- Boş Durum -->
        <TextView
            android:id="@+id/tv_visitor_empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Henüz paylaşılan bir risale bulunmuyor"
            android:textColor="@color/text_tertiary"
            android:textSize="13sp"
            android:visibility="gone" />

    </FrameLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
