<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/container_toast"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="center_horizontal|top"
    android:layout_marginHorizontal="20dp"
    android:layout_marginTop="32dp"
    android:background="@drawable/bg_glass_toast"
    android:elevation="12dp"
    android:gravity="center_vertical"
    android:maxWidth="400dp"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingVertical="12dp">

    <!-- Toast İkonu (Altın ışıltılı) -->
    <TextView
        android:id="@+id/tv_toast_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="✨"
        android:textSize="20sp" />

    <!-- Mesaj Alanı -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_toast_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/gold_vibrant"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="İlmNet Bildirimi" />

        <TextView
            android:id="@+id/tv_toast_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:lineSpacingExtra="1dp"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            tools:text="Akademik profil başarıyla güncellendi!" />
    </LinearLayout>

</LinearLayout>
