<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_mesh_gradient"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Üst Tutamaç (BottomSheet Handle) -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_color_dot_yellow" />

    <!-- Başlık ve Kapat Butonu -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="serif"
            android:letterSpacing="0.08"
            android:text="📜 Tarihçe-i İlmNet (Sürüm Günlükleri)"
            android:textColor="#FFD700"
            android:textSize="17sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btn_close_release_notes"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Kapat"
            android:padding="4dp"
            android:src="@drawable/ic_close_circle"
            app:tint="#888888" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="İlim Diyârı mimarisinin destansı kronolojisi ve operasyon defteri"
        android:textColor="#8E8E93"
        android:textSize="12sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="14dp"
        android:background="#22D4AF37" />

    <!-- Destansı Günlükler Listesi -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="480dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- Faz 12 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_glass_card"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="👑 FAZ 12: Büyük Kütüphane &amp; S-Pen İradesi"
                    android:textColor="#FFD700"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="3dp"
                    android:text="Tablet saraylarına yayılma başladı; S-Pen akıllı kalemi kırmızı mürekkeple sahifelere dokundu. Ciltli kütüphane rafları bordo, lacivert ve zümrüt deri sırtlarla yükseldi. Seher vaktinde ilme koşanlara gizli teheccüd nişanları bahşedildi."
                    android:textColor="#E0E0E0"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Faz 11 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_glass_card"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🌐 FAZ 11: Sınırlar Kalktı, Ağa Fısıltılar Karıştı"
                    android:textColor="#00E676"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="3dp"
                    android:text="Yeryüzündeki tüm araştırmacıların risaleleri tek bir mecliste birleşti. Dünyanın gürültüsünden kaçıp hakikate dalmak isteyen mütefekkirler için 'İtikâf Modu' mühürlendi; Smart Resume ile kalınan satırlar unutulmadı."
                    android:textColor="#E0E0E0"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Faz 10 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_glass_card"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🪞 FAZ 10: Mütalaa Aynası (Canlı Widget)"
                    android:textColor="#2979FF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="3dp"
                    android:text="Cihazın ana ekranına canlı akademik ayna yerleştirildi. Talebeler ekrana her baktığında zihnini tazeleyen hikmetli sözler ve mütalaa istatistikleriyle karşılandı."
                    android:textColor="#E0E0E0"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Faz 9 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_glass_card"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎖️ FAZ 9: İlim Meclisine Hiyerarşi Geldi. Rozetler Kuşandı."
                    android:textColor="#D4AF37"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="3dp"
                    android:text="Mübtedîden Allâme zirvesine uzanan 20 ilmi disiplinde rütbeler dağıtıldı. Bakır, gümüş, altın ve elmas sergi rafları akademisyenlerin göğsüne takıldı."
                    android:textColor="#E0E0E0"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Faz 7 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_glass_card"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🛡️ FAZ 7: IMF Protokolü &amp; Gizli Mühür"
                    android:textColor="#FF5252"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="3dp"
                    android:text="Sistemin mimarları tarihe not düştü; Muhammed Bahadır Yıldırım ve Yıldırım Technologies kadrosunun mührü gizli terminal protokolüyle şifrelendi."
                    android:textColor="#E0E0E0"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Faz 5 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_glass_card"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="👤 FAZ 5: Akademik Hüviyet &amp; Kişisel Mühür"
                    android:textColor="#FFAB40"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="3dp"
                    android:text="WhatsApp zarafetinde dairesel portreler kırpıldı; araştırmacıların unvanları, biyografileri ve akademik kimlikleri portale nakşedildi."
                    android:textColor="#E0E0E0"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Faz 4 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_glass_card"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🖍️ FAZ 4: Fosforlu Mürekkep &amp; Satır Altları"
                    android:textColor="#FFE600"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="3dp"
                    android:text="Kadim ulemanın derkenar notları gibi sahifeler sarı, mavi, yeşil ve kırmızı fosforlu renklerle aydınlatıldı; serbest çizim tuvali açıldı."
                    android:textColor="#E0E0E0"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Faz 1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_glass_card"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚡ FAZ 1: İlk Kıvılcım &amp; Mabedin Temelleri"
                    android:textColor="#C5A059"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="3dp"
                    android:text="Akademik tevhid ve ilim platformunun ilk tuğlası konuldu. Çevrimdışı çalışan sarsılmaz SQLite kasası mühürlendi; İlim Diyârı tecessüm etti."
                    android:textColor="#E0E0E0"
                    android:textSize="12sp" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
