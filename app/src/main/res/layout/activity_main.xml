<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_mesh_gradient">

    <!-- Splash Screen View (Açılışta gösterilir) -->
    <include
        android:id="@+id/view_splash"
        layout="@layout/view_splash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="visible" />

    <!-- Auth Screen View (Giriş yapılmadığında gösterilir) -->
    <include
        android:id="@+id/view_auth"
        layout="@layout/view_auth"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- Ana Ekran: Akış (Feed) -->
    <include
        android:id="@+id/view_feed"
        layout="@layout/view_feed"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- PDF Ekleme Ekranı -->
    <include
        android:id="@+id/view_add_pdf"
        layout="@layout/view_add_pdf"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- Profil Ekranı (Dashboard) -->
    <include
        android:id="@+id/view_dashboard"
        layout="@layout/view_dashboard"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- Yerleşik PDF Okuyucu (PdfRenderer - Faz 3) -->
    <include
        android:id="@+id/view_pdf_reader"
        layout="@layout/view_pdf_reader"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- Profili Düzenle Ekranı (Faz 5) -->
    <include
        android:id="@+id/view_edit_profile"
        layout="@layout/view_edit_profile"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- Ayarlar Ekranı (Faz 5) -->
    <include
        android:id="@+id/view_settings"
        layout="@layout/view_settings"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- Ziyaretçi Profili ve Dinamik Ekranlar İçin Fragment Taşıyıcı -->
    <FrameLayout
        android:id="@+id/fragment_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- Havada Duran Cam Efektli Alt Navigasyon (Floating Bottom Nav) -->
    <include
        android:id="@+id/layout_bottom_nav"
        layout="@layout/layout_bottom_nav"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:visibility="gone" />

    <!-- Coşkulu Konfeti & Tebrik Kutlama Animasyonu Katmanı (Faz 5) -->
    <com.example.ui.common.CelebrationConfettiView
        android:id="@+id/view_confetti"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- Gerçek Göz Koruma & Mavi Işık Filtresi Katmanı (Faz 6) -->
    <View
        android:id="@+id/view_eye_protection_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/amber_eye_filter"
        android:clickable="false"
        android:focusable="false"
        android:visibility="gone" />

</FrameLayout>
