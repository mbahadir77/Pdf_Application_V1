<?xml version="1.0" encoding="utf-8"?>
<!--
    İlim Diyârı - Gerçek Buzlu Cam (Frosted Glass) Kart Tasarımı (FAZ 13).
    %12 şeffaflıkta beyaz/açık cam dolgu (#1AFFFFFF) ve 1dp kalınlığında
    %20 şeffaflıkta parlayan beyaz çerçeve (#33FFFFFF).
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#1AFFFFFF" />
    <stroke
        android:width="1dp"
        android:color="#33FFFFFF" />
    <corners android:radius="20dp" />
</shape>
