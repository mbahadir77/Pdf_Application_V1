<?xml version="1.0" encoding="utf-8"?>
<!-- İlim Diyârı - Klasik Arapça/Osmanlı Ciltli Eser Sırtı (Lacivert Deri & Altın Yaldız) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 1. Gece Mavisi Deri Zemin -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#091422"
                android:centerColor="#14263D"
                android:endColor="#060E18"
                android:type="linear" />
            <corners android:radius="5dp" />
            <stroke
                android:width="2dp"
                android:color="#D4AF37" />
        </shape>
    </item>

    <!-- 2. İç Altın Yaldız Çerçeve -->
    <item
        android:left="4dp"
        android:right="4dp"
        android:top="5dp"
        android:bottom="5dp">
        <shape android:shape="rectangle">
            <corners android:radius="3dp" />
            <stroke
                android:width="1dp"
                android:color="#B3D4AF37" />
        </shape>
    </item>

    <!-- 3. Üst Cilt Sırtı Nervürü / Şiraze Kuşağı -->
    <item
        android:top="16dp"
        android:left="5dp"
        android:right="5dp"
        android:height="3dp">
        <shape android:shape="rectangle">
            <solid android:color="#F5D061" />
            <corners android:radius="1dp" />
        </shape>
    </item>
    <item
        android:top="22dp"
        android:left="7dp"
        android:right="7dp"
        android:height="1.5dp">
        <shape android:shape="rectangle">
            <solid android:color="#99D4AF37" />
        </shape>
    </item>

    <!-- 4. Alt Cilt Sırtı Nervürü / Şiraze Kuşağı -->
    <item
        android:bottom="22dp"
        android:left="7dp"
        android:right="7dp"
        android:height="1.5dp">
        <shape android:shape="rectangle">
            <solid android:color="#99D4AF37" />
        </shape>
    </item>
    <item
        android:bottom="16dp"
        android:left="5dp"
        android:right="5dp"
        android:height="3dp">
        <shape android:shape="rectangle">
            <solid android:color="#F5D061" />
            <corners android:radius="1dp" />
        </shape>
    </item>
</layer-list>
