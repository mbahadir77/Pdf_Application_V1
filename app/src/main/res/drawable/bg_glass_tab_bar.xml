<?xml version="1.0" encoding="utf-8"?>
<!--
    İlim Diyârı - Net & Ferah Yarı Şeffaf Alt Navigasyon Çubuğu (FAZ 13 Düzeltme).
    Blur katmanı yerine doğrudan #E60A1C15 yarı şeffaf ferah koyu yeşil zemin
    ve 1dp %20 şeffaf beyaz (#33FFFFFF) cam çerçeve ile ikon ve yazılar jilet gibi net.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#E60A1C15" />
    <stroke
        android:width="1dp"
        android:color="#33FFFFFF" />
    <corners android:radius="32dp" />
</shape>
