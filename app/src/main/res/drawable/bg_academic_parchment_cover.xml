<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Koyu Zümrüt / Arşiv Deri Zemin -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:endColor="#0B1A14"
                android:centerColor="#11241C"
                android:startColor="#183327"
                android:type="linear" />
            <corners android:radius="12dp" />
        </shape>
    </item>

    <!-- İnce Altın Çerçeve Çizgisi -->
    <item
        android:bottom="8dp"
        android:left="8dp"
        android:right="8dp"
        android:top="8dp">
        <shape android:shape="rectangle">
            <stroke
                android:width="1dp"
                android:color="#40D4AF37"
                android:dashWidth="4dp"
                android:dashGap="2dp" />
            <corners android:radius="8dp" />
        </shape>
    </item>

    <!-- Merkezdeki Klasik Kitap İkonu -->
    <item
        android:gravity="center"
        android:width="44dp"
        android:height="44dp">
        <bitmap
            android:src="@drawable/ic_share"
            android:tint="#80D4AF37" />
    </item>
</layer-list>
