<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Kütüphane Ahşap Arka Plan Paneli -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#1F130B"
                android:centerColor="#2B1A0F"
                android:endColor="#140C07"
                android:type="linear" />
            <corners android:radius="8dp" />
            <stroke
                android:width="1dp"
                android:color="#422817" />
        </shape>
    </item>

    <!-- Alt Ahşap Raf Çıtası (Ledge) -->
    <item
        android:bottom="0dp"
        android:height="12dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#633C21"
                android:centerColor="#422816"
                android:endColor="#21140B" />
            <corners
                android:bottomLeftRadius="8dp"
                android:bottomRightRadius="8dp" />
        </shape>
    </item>

    <!-- Raf Üst Işık / Yaldız Çizgisi -->
    <item
        android:bottom="11dp"
        android:height="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#99D4AF37" />
        </shape>
    </item>
</layer-list>
